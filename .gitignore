# IDE config / IDE 配置
.idea/

# Claude Code local settings / Claude Code 本地配置
.claude/

# Session transcripts / 会话记录
*claude-switchlist*.txt

# OS files / 系统文件
.DS_Store
Thumbs.db
desktop.ini

# Editor temp files / 编辑器临时文件
*.swp
*.swo
*~

# Environment files / 环境变量文件（可能含密钥）
.env
.env.*
*.env
!.env.example

# Logs & temp files / 日志与临时文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak

# Dependencies / 依赖目录
node_modules/

# Python build artifacts / Python 编译产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Other editor configs / 其他编辑器配置
.vscode/
